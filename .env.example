# Copy to .env and fill in. Never commit real secrets.
SECRET_KEY=change-this-to-a-random-string

# Alert rules
LOW_STOCK_THRESHOLD=10
DEMAND_WINDOW_DAYS=7
DEMAND_MIN_UNITS=5

# Checkout
TAX_RATE=0

# Paynow (Zimbabwe payment gateway: card, EcoCash, OneMoney).
# Sign up at https://www.paynow.co.zw -> "Create Advanced Integration" to get
# these. New integrations start in Test Mode automatically - no real money
# moves until you explicitly request to go live. Leave blank to disable
# card/mobile money at checkout (cash/other always work).
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MERCHANT_EMAIL=
# Must be publicly reachable for Paynow's result_url webhook to work; the
# app works fine on 127.0.0.1 too since it polls for payment status instead.
APP_BASE_URL=http://127.0.0.1:5000

# Automated digest: hour (0-23) to auto-send the daily digest. Blank disables.
DIGEST_HOUR=

PAGE_SIZE=20

# Admin contact numbers (E.164 format). One number, or several
# comma-separated to alert more than one person, e.g. +2348000000000,+2348011111111
ADMIN_WHATSAPP=+2348000000000
ADMIN_SMS=+2348000000000

# Twilio (leave blank to run in offline/log mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
